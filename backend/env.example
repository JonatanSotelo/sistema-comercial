# Database
DATABASE_URL=postgresql+psycopg2://appuser:apppass@sc_postgres:5432/appdb

# Redis
REDIS_URL=redis://sc_redis:6379/0

# API
API_BASE_URL=http://localhost:8000
SECRET_KEY=dev-secret-change-in-production

# Backups
BACKUP_DIR=/data/backups

# WhatsApp Integration
WHATS_ORDERS_TOKEN=test-token-123
WHATS_CREATE_ORDERS=true

# Notifications (v0.8.0+)
NOTIFY_ON_READY=false
NOTIFY_WHATS_ENDPOINT=
NOTIFY_WHATS_TOKEN=

# SMTP (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sistema-comercial.com
