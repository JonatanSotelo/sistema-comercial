# Database
DATABASE_URL=postgresql+psycopg2://appuser:apppass@sc_postgres:5432/appdb

# Redis
REDIS_URL=redis://sc_redis:6379/0

# API
API_BASE_URL=http://localhost:8000
SECRET_KEY=dev-secret-change-in-production

# Backups
BACKUP_DIR=/data/backups

# WhatsApp Integration
WHATS_ORDERS_TOKEN=test-token-123
WHATS_CREATE_ORDERS=true

# Notifications (v0.8.0+)
NOTIFY_ON_READY=false
NOTIFY_WHATS_ENDPOINT=
NOTIFY_WHATS_TOKEN=

# SMTP (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sistema-comercial.com

# AFIP Facturación (v0.9.0+)
AFIP_ENV=homologacion
AFIP_CUIT=20123456789
AFIP_CERT_PATH=/secrets/afip.crt
AFIP_KEY_PATH=/secrets/afip.key
AFIP_CERT_PASS=
AFIP_WSDL_WSAA=https://wsaahomo.afip.gov.ar/ws/services/LoginCms?wsdl
AFIP_WSDL_WSFEV1=https://wswhomo.afip.gov.ar/wsfev1/service.asmx?WSDL
FACTURA_PTO_VTA=1
FACTURA_MONEDA=ARS
FACTURA_COTIZACION=1.000

# Cobros & Caja (v0.9.1+)
RECIBO_SERIE=R
RECIBO_PDF_FOOTER=Gracias por su pago
